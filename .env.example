# Passwort für deinen Bereich (/admin). Unbedingt ändern!
ADMIN_PASSWORD=bitte-aendern

# Port, auf dem die Webseite läuft
PORT=3000

# Zeitzone des Salons
TIMEZONE=Europe/Berlin

# Wo die Datenbank gespeichert wird (Ordner muss beschreibbar sein)
DB_PATH=./data/salon.db

# Feste Adresse der Webseite (für den Link in der Bestätigungs-E-Mail)
# PUBLIC_URL=https://termine.mein-salon.de

# Bestätigung per E-Mail – nur nötig, wenn Kunden eine E-Mail bekommen sollen.
# Zugangsdaten bekommst du von deinem E-Mail-Anbieter („SMTP-Server“).
# SMTP_HOST=smtp.example.de
# SMTP_PORT=465
# SMTP_USER=termine@mein-salon.de
# SMTP_PASS=passwort-des-postfachs
# MAIL_FROM=termine@mein-salon.de
